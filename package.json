{
  "name": "pump-kit",
  "version": "0.2.5",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./simple": {
      "types": "./dist/types/simple.d.ts",
      "import": "./dist/simple.js"
    },
    "./launch": {
      "types": "./dist/types/launch.d.ts",
      "import": "./dist/launch.js"
    },
    "./launch/store": {
      "types": "./dist/types/launch/file_store.d.ts",
      "import": "./dist/launch/file_store.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "@pump-kit.png",
    "llms.txt",
    "metadata/actions-registry.json"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev:typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts examples",
    "lint:fix": "oxlint --fix --deny-warnings src tests scripts examples",
    "build:js": "bun build ./src/index.ts ./src/simple.ts ./src/launch.ts --outdir dist --format esm --packages external --minify",
    "build:store": "bun build ./src/launch/file_store.ts --outdir dist/launch --format esm --packages external --target node --minify",
    "build:binary": "mkdir -p dist/bin && PUMP_KIT_VERSION=$(bun -p \"require('./package.json').version\") bun build --compile --env='PUMP_KIT_VERSION' --outfile dist/bin/pump-kit ./src/bin/pump-kit.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "rm -rf dist && bun run build:js && bun run build:store && bun run build:cli && bun run build:types",
    "ci": "bun run dev:typecheck && bun run lint && bun run test:unit && bun run test:integration && bun run build",
    "release": "bun run scripts/release.ts",
    "codegen": "bun run scripts/codama-generate.ts",
    "idl:update": "bun run scripts/update-idls.ts && bun run codegen",
    "idl:check": "bun run scripts/update-idls.ts --check",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "validator:prepare": "bun run scripts/prepare-validator.ts",
    "test:validator": "bun run scripts/verify-validator.ts",
    "test:launch": "bun run scripts/verify-launch.ts",
    "test:integration": "bun test tests/integration",
    "test:package": "bun run build && bun run scripts/verify-package.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun run build",
    "build:cli": "bun build ./src/bin/pump-kit.ts --outdir dist/bin --format esm --target bun --minify"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.5.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@types/bun": "^1.3.1",
    "@types/node": "^24.9.2",
    "codama": "^1.11.0",
    "oxlint": "^1.49.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@solana-program/address-lookup-table": "0.15.0",
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "^8.4.0",
    "buffer": "^6.0.3"
  },
  "bin": {
    "pump-kit": "./dist/bin/pump-kit.js"
  }
}

{
  "schemaVersion": "1.0.0",
  "package": "pump-kit",
  "entrypoints": [
    "pump-kit",
    "pump-kit/simple",
    "pump-kit/launch",
    "pump-kit/launch/store"
  ],
  "jsonConventions": {
    "bigintEncoding": "decimal-string",
    "notes": [
      "When invoking from JSON tools, encode bigint inputs as strings, then cast to BigInt in runtime code.",
      "All slippage values are basis points (bps)."
    ]
  },
  "actions": [
    {
      "name": "createPump().launch.prepare",
      "entrypoint": "pump-kit/launch",
      "description": "Prepare a SOL-paired Token-2022 launch, optionally with an atomic bonding-curve first buy.",
      "requiredParams": [
        "config",
        "signer",
        "mint"
      ],
      "optionalParams": [
        "saveRecord",
        "addressLookupTables",
        "priorityFees",
        "prependInstructions",
        "appendInstructions",
        "expectedMint"
      ],
      "returns": "LaunchSession",
      "notes": [
        "Upload metadata first and supply metadataUri.",
        "Omit firstBuy for create-only launches.",
        "Persist the signed identity before broadcast with saveRecord.",
        "Call setup or supply an active lookup table before atomic first-buy simulation.",
        "A chosen CA requires the corresponding mint signer. expectedMint rejects mismatches before RPC."
      ]
    },
    {
      "name": "buy",
      "entrypoint": "pump-kit",
      "description": "Build an automatically routed buy plan for a bonding curve or migrated AMM pool.",
      "returns": "SwapPlan"
    },
    {
      "name": "sell",
      "entrypoint": "pump-kit",
      "description": "Build an automatically routed sell plan for a bonding curve or migrated AMM pool.",
      "returns": "SwapPlan"
    },
    {
      "name": "curveBuy",
      "entrypoint": "pump-kit",
      "description": "Build bonding-curve buy instruction with slippage guard.",
      "requiredParams": [
        "user",
        "mint",
        "solAmount",
        "rpc"
      ],
      "optionalParams": [
        "slippageBps",
        "feeRecipient",
        "bondingCurveCreator",
        "trackVolume",
        "curveStateOverride",
        "feeStructureOverride",
        "allowAtaCreation",
        "commitment"
      ],
      "returns": "SwapPlan"
    },
    {
      "name": "curveSell",
      "entrypoint": "pump-kit",
      "description": "Build bonding-curve sell instruction using fixed token amount or wallet percentage.",
      "requiredParams": [
        "user",
        "mint",
        "rpc"
      ],
      "optionalParams": [
        "tokenAmount",
        "useWalletPercentage",
        "walletPercentage",
        "tokenDecimals",
        "slippageBps",
        "feeRecipient",
        "bondingCurveCreator",
        "curveStateOverride",
        "feeStructureOverride",
        "commitment"
      ],
      "returns": "SwapPlan"
    },
    {
      "name": "ammBuy",
      "entrypoint": "pump-kit",
      "description": "Build AMM buy instruction from a SOL budget.",
      "requiredParams": [
        "user",
        "mint",
        "solAmount",
        "rpc"
      ],
      "optionalParams": [
        "slippageBps",
        "poolAddress",
        "poolCreator",
        "poolIndex",
        "quoteMint",
        "allowTrackVolume",
        "commitment"
      ],
      "returns": "SwapPlan"
    },
    {
      "name": "ammSell",
      "entrypoint": "pump-kit",
      "description": "Build AMM sell instruction using fixed amount or wallet percentage.",
      "requiredParams": [
        "user",
        "mint",
        "rpc"
      ],
      "optionalParams": [
        "tokenAmount",
        "tokenDecimals",
        "slippageBps",
        "useWalletPercentage",
        "walletPercentage",
        "poolAddress",
        "poolCreator",
        "poolIndex",
        "quoteMint",
        "allowTrackVolume",
        "commitment"
      ],
      "returns": "SwapPlan"
    },
    {
      "name": "addLiquidity",
      "entrypoint": "pump-kit",
      "description": "Build AMM liquidity deposit instruction.",
      "requiredParams": [
        "user",
        "baseMint",
        "maxBaseAmountIn",
        "maxQuoteAmountIn"
      ],
      "optionalParams": [
        "quoteMint",
        "poolIndex",
        "poolAddress",
        "poolCreator",
        "lpTokenAmountOut",
        "tokenProgram",
        "token2022Program"
      ],
      "returns": "Instruction"
    },
    {
      "name": "removeLiquidity",
      "entrypoint": "pump-kit",
      "description": "Build AMM liquidity withdraw instruction.",
      "requiredParams": [
        "user",
        "baseMint",
        "lpAmountIn"
      ],
      "optionalParams": [
        "quoteMint",
        "poolIndex",
        "poolAddress",
        "poolCreator",
        "minBaseAmountOut",
        "minQuoteAmountOut",
        "tokenProgram",
        "token2022Program"
      ],
      "returns": "Instruction"
    },
    {
      "name": "mintWithFirstBuy",
      "entrypoint": "pump-kit",
      "description": "Create token mint + initial curve buy instructions.",
      "requiredParams": [
        "user",
        "mint",
        "name",
        "symbol",
        "uri",
        "rpc"
      ],
      "optionalParams": [
        "slippageBps",
        "feeRecipient",
        "bondingCurveCreator",
        "trackVolume",
        "commitment",
        "firstBuyAmountSol",
        "firstBuyTokenAmount",
        "estimatedFirstBuyCost",
        "holderReward"
      ],
      "returns": "MintWithFirstBuyInstructions",
      "notes": [
        "Use firstBuyAmountSol for an exact decimal SOL budget, or supply firstBuyTokenAmount with estimatedFirstBuyCost; do not mix modes."
      ]
    },
    {
      "name": "createAndBuy",
      "entrypoint": "pump-kit",
      "description": "Create and buy using the caller-supplied mint signer, then send and confirm the transaction.",
      "requiredParams": [
        "creator",
        "metadata",
        "rpc",
        "rpcSubscriptions",
        "mint"
      ],
      "optionalParams": [
        "slippageBps",
        "feeRecipient",
        "bondingCurveCreator",
        "mintAuthority",
        "priorityFees",
        "prependInstructions",
        "appendInstructions",
        "additionalSigners",
        "sendOptions",
        "commitment",
        "firstBuyAmountSol",
        "firstBuyTokenAmount",
        "estimatedFirstBuyCost",
        "addressLookupTables"
      ],
      "returns": "CreateAndBuyResult",
      "notes": [
        "Use firstBuyAmountSol for an exact decimal SOL budget, or supply firstBuyTokenAmount with estimatedFirstBuyCost; do not mix modes."
      ]
    },
    {
      "name": "buildTransaction",
      "entrypoint": "pump-kit",
      "description": "Build transaction message with optional priority fee and prepend/append instruction hooks.",
      "requiredParams": [
        "instructions",
        "payer",
        "rpc"
      ],
      "optionalParams": [
        "additionalSigners",
        "prependInstructions",
        "appendInstructions",
        "priorityFees",
        "version",
        "commitment",
        "lifetime",
        "addressLookupTables"
      ],
      "returns": "BuiltTransaction"
    },
    {
      "name": "sendAndConfirmTransaction",
      "entrypoint": "pump-kit",
      "description": "Build, sign, send, and confirm transaction.",
      "requiredParams": [
        "instructions",
        "payer",
        "rpc",
        "rpcSubscriptions"
      ],
      "optionalParams": [
        "additionalSigners",
        "prependInstructions",
        "appendInstructions",
        "priorityFees",
        "version",
        "sendOptions",
        "commitment",
        "lifetime",
        "addressLookupTables",
        "onSigned"
      ],
      "returns": "TransactionResult"
    },
    {
      "name": "simulateTransaction",
      "entrypoint": "pump-kit",
      "description": "Build and simulate transaction without sending.",
      "requiredParams": [
        "instructions",
        "payer",
        "rpc"
      ],
      "optionalParams": [
        "additionalSigners",
        "prependInstructions",
        "appendInstructions",
        "priorityFees",
        "version",
        "options",
        "commitment",
        "lifetime",
        "addressLookupTables"
      ],
      "returns": "SimulationResponse"
    }
  ]
}
